    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment">

    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.konwerter3.ListFragment"
        android:label="fragment_list"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_converterFragment"
            app:destination="@id/converterFragment" />
    </fragment>

    <fragment
        android:id="@+id/converterFragment"
        android:name="com.example.konwerter3.ConverterFragment"
        android:label="fragment_converter"
        tools:layout="@layout/fragment_converter" />
